# =============================================
# TAVALLIN — Environment Variable Reference
# =============================================
# Copy this file to .env and fill in real values.
# NEVER commit .env with real secrets.

# ─── App ────────────────────────────────────
NODE_ENV=development
APP_NAME=Tavallin
APP_VERSION=1.0.0
LOG_LEVEL=debug

# ─── API Server ─────────────────────────────
API_PORT=3000
API_BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:19006

# ─── Database ───────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=tavallin_dev
DB_USER=tavallin
DB_PASSWORD=tavallin_secret
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_LOGGING=false

# Test database (used by Jest integration tests)
TEST_DB_NAME=tavallin_test
TEST_DB_HOST=localhost
TEST_DB_PORT=3306
TEST_DB_USER=tavallin
TEST_DB_PASSWORD=tavallin_secret

# ─── JWT Auth ───────────────────────────────
JWT_ACCESS_SECRET=REPLACE_WITH_64_CHAR_RANDOM_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_64_CHAR_RANDOM_SECRET
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Email (SMTP) ───────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@tavallin.com
SMTP_PASS=REPLACE_WITH_SMTP_PASSWORD
EMAIL_FROM="Tavallin <noreply@tavallin.com>"

# ─── Object Storage (S3 / Cloudflare R2) ────
STORAGE_PROVIDER=s3
STORAGE_BUCKET=tavallin-media
STORAGE_REGION=ap-south-1
STORAGE_ENDPOINT=https://s3.ap-south-1.amazonaws.com
STORAGE_ACCESS_KEY_ID=REPLACE_WITH_ACCESS_KEY
STORAGE_SECRET_ACCESS_KEY=REPLACE_WITH_SECRET_KEY
STORAGE_PUBLIC_BASE_URL=https://cdn.tavallin.com
STORAGE_UPLOAD_SIZE_LIMIT_MB=10
STORAGE_PRESIGNED_EXPIRY_SECONDS=300

# ─── Firebase (FCM Push Notifications) ──────
FIREBASE_PROJECT_ID=REPLACE_WITH_FIREBASE_PROJECT_ID
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# Or use inline JSON:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# ─── Rate Limiting ───────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=10

# ─── Password Reset ──────────────────────────
PASSWORD_RESET_TOKEN_EXPIRES_MIN=60
EMAIL_VERIFY_TOKEN_EXPIRES_HOURS=24

# ─── Admin ───────────────────────────────────
# Used for initial admin seeding only — change immediately after setup
ADMIN_BOOTSTRAP_EMAIL=admin@tavallin.com
ADMIN_BOOTSTRAP_PASSWORD=REPLACE_IMMEDIATELY_AFTER_SETUP

# ─── Affiliate / Shopping ────────────────────
AFFILIATE_DISCLOSURE_URL=https://tavallin.com/affiliate-disclosure

# ─── Feature Flags ───────────────────────────
FEATURE_PUSH_NOTIFICATIONS=true
FEATURE_EMAIL_VERIFICATION=true
FEATURE_WEATHER_RECOMMENDATIONS=false
FEATURE_AI_STYLIST=false

# ─── External APIs (optional) ────────────────
OPENWEATHER_API_KEY=REPLACE_IF_USING_WEATHER
AI_STYLIST_PROVIDER=none
AI_STYLIST_API_KEY=REPLACE_IF_USING_AI

# ─── Monitoring (optional) ───────────────────
SENTRY_DSN=
